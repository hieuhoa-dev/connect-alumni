# Better-Auth Configuration
BETTER_AUTH_SECRET=your_random_secret_at_least_32_chars_long
BETTER_AUTH_URL=http://localhost:3000

# Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/connect_alumni

# Redis Configuration (BullMQ & Rate Limiter)
REDIS_URL=redis://localhost:6379

# S3-compatible Storage (SeaweedFS, Cloudflare R2, AWS S3)
# For local SeaweedFS via Docker:
# AWS_ENDPOINT_URL_S3=http://localhost:8333
# AWS_ACCESS_KEY_ID=seaweedadmin
# AWS_SECRET_ACCESS_KEY=seaweedadmin
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=alumni
AWS_ENDPOINT_URL_S3=http://localhost:8333
AWS_ACCESS_KEY_ID=seaweedadmin
AWS_SECRET_ACCESS_KEY=seaweedadmin
AWS_REGION=us-east-1
S3_BUCKET_NAME=alumni

# Application Feature Flags & Demo Controls
# Set ENABLE_DEMO_LOGIN=true only in development/staging test environments.
# Never enable in production.
ENABLE_DEMO_LOGIN=false
ENABLE_DEMO_DATA=false
