# Required for authentication and all database-backed features.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/connect_alumni
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Optional: background email and job-expiry queue. In-app notifications work without Redis.
REDIS_URL=

# Optional S3-compatible object storage for uploaded files.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=connect-alumni
